  m_Script: {fileID: 11500000, guid: 6921359ab55737b45a1b04d6933b6da0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::BorrowedTime.BTExpansionWorld
  game: {fileID: 1358039362}
  chapter: "\u0E2A\u0E27\u0E19\u0E1A\u0E31\u0E19\u0E17\u0E36\u0E01\u0E24\u0E14\u0E39\u0E01\u0E32\u0E25"
  puzzles:
  - id: TrainingArea_0
    title: "\u0E2A\u0E27\u0E19\u0E2B\u0E22\u0E14\u0E19\u0E49\u0E33\u0E41\u0E23\u0E01"
    clue: "\u0E01\u0E31\u0E07\u0E2B\u0E31\u0E19\u0E43\u0E2B\u0E21\u0E48\u0E2A\u0E48\u0E07\u0E19\u0E49\u0E33
      / \u0E15\u0E49\u0E19\u0E01\u0E25\u0E49\u0E32\u0E42\u0E15\u0E40\u0E15\u0E47\u0E21\u0E27\u0E31\u0E22\u0E23\u0E31\u0E1A\u0E41\u0E2A\u0E07
      / \u0E23\u0E32\u0E01\u0E41\u0E01\u0E48\u0E40\u0E1B\u0E34\u0E14\u0E0A\u0E48\u0E2D\u0E07\u0E19\u0E49\u0E33\n\u0E27\u0E32\u0E25\u0E4C\u0E27\u0E2D\u0E48\u0E32\u0E19\u0E0B\u0E49\u0E32\u0E22\u0E44\u0E1B\u0E02\u0E27\u0E32\u0E15\u0E32\u0E21\u0E1B\u0E49\u0E32\u0E22
      \u0E40\u0E1B\u0E25\u0E35\u0E48\u0E22\u0E19\u0E2D\u0E32\u0E22\u0E38\u0E2D\u0E22\u0E48\u0E32\u0E07\u0E40\u0E14\u0E35\u0E22\u0E27\u0E44\u0E21\u0E48\u0E1E\u0E2D
      \u0E15\u0E49\u0E2D\u0E07\u0E2A\u0E48\u0E07\u0E19\u0E49\u0E33\u0E16\u0E39\u0E01\u0E0A\u0E48\u0E2D\u0E07\u0E14\u0E49\u0E27\u0E22"
    lore: "Norman \u0E17\u0E14\u0E25\u0E2D\u0E07\u0E1F\u0E37\u0E49\u0E19\u0E1F\u0E39\u0E23\u0E30\u0E1A\u0E1A\u0E19\u0E34\u0E40\u0E27\u0E28\u0E14\u0E49\u0E27\u0E22\u0E19\u0E49\u0E33
      \u0E41\u0E2A\u0E07 \u0E41\u0E25\u0E30\u0E40\u0E27\u0E25\u0E32"
    optional: 0
    solved: 0
    collected: 0
