    clue: "\u0E1B\u0E49\u0E32\u0E22\u0E0A\u0E48\u0E32\u0E07\u0E40\u0E02\u0E35\u0E22\u0E19\u0E08\u0E32\u0E01\u0E1D\u0E31\u0E48\u0E07\u0E01\u0E23\u0E30\u0E08\u0E01
