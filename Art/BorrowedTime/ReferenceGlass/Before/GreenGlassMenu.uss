.game-title {
    height: 36%; background-image: url("Art/GreenGlassTitle.png"); background-size: 100% 100%;
    align-items: center; justify-content: center; padding: 25px 38px 12px 38px;
}
.glass-title-word {
    flex-shrink: 0; margin: 0; padding: 0; max-width: 100%;
    -unity-font: url("Fonts/LobsterTwo-BoldItalic.ttf"); -unity-font-definition: initial;
    -unity-font-style: normal; font-size: 79px;
    color: rgb(250, 255, 231); -unity-text-align: middle-center;
    -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(29, 109, 20);
    text-shadow: 0 3px 3px rgba(13, 57, 13, 0.38);
}
.glass-title-time { font-size: 90px; margin-top: -8px; }
.botanical-button, .play-button {
    height: 180px; font-size: 59px; padding: 0 70px;
    background-image: url("Art/GreenGlassButton.png");
    -unity-font: url("Fonts/Quicksand-Variable.ttf"); -unity-font-definition: initial; -unity-font-style: bold;
    color: rgb(250, 255, 232); -unity-text-outline-width: 0.5px; -unity-text-outline-color: rgba(14, 84, 18, 0.65);
    text-shadow: 0 3px 3px rgba(8, 55, 13, 0.48);
}
.botanical-button:hover, .botanical-button:focus { -unity-background-image-tint-color: rgb(250, 255, 223); }
.botanical-button:active { -unity-background-image-tint-color: rgb(218, 238, 185); }
.glass-button-trim { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.compact .glass-title-word { font-size: 65px; }
.compact .glass-title-time { font-size: 76px; }
.compact .botanical-button, .compact .play-button { font-size: 48px; padding: 0 62px; }
.portrait .game-title { height: 29%; padding: 16px 30px 10px 30px; }
.portrait .glass-title-word { font-size: 57px; }
.portrait .glass-title-time { font-size: 68px; }
.portrait .botanical-button, .portrait .play-button { font-size: 43px; padding: 0 55px; max-height: 190px; }
