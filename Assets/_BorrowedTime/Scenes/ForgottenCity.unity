    clue: "\u0E01\u0E31\u0E07\u0E2B\u0E31\u0E19\u0E0A\u0E48\u0E27\u0E07\u0E43\u0E0A\u0E49\u0E07\u0E32\u0E19\u0E2A\u0E48\u0E07\u0E19\u0E49\u0E33\u0E1E\u0E2D\u0E14\u0E35
