.game-title {
    height: 36%; background-image: none;
    align-items: center; justify-content: center; padding: 22px 28px 16px 28px;
    --glass-top: rgba(46, 117, 100, 0.97); --glass-bottom: rgba(65, 141, 120, 0.98); --glass-rim: rgb(235, 255, 229);
}
.game-title:hover, .game-title:focus { --glass-rim: rgb(255, 255, 235); }
.glass-title-word {
    flex-shrink: 0; margin: 0; padding: 0; max-width: 100%;
    -unity-font: url("Fonts/LobsterTwo-BoldItalic.ttf"); -unity-font-definition: initial;
    -unity-font-style: normal; font-size: 100px;
    color: rgb(251, 255, 243); -unity-text-align: middle-center;
    -unity-text-outline-width: 3px; -unity-text-outline-color: rgb(111, 180, 147);
    text-shadow: 0 3px 2px rgba(16, 65, 50, 0.45);
}
.glass-title-time { font-size: 116px; margin-top: -8px; }
.botanical-button, .play-button {
    height: 146px; font-size: 58px; padding: 0 66px;
    background-image: none; background-color: rgba(0, 0, 0, 0);
    -unity-font: url("Fonts/Quicksand-Variable.ttf"); -unity-font-definition: initial; -unity-font-style: bold;
    color: rgba(0, 0, 0, 0); -unity-text-outline-width: 0; text-shadow: 0 0 0 rgba(0, 0, 0, 0);
    --glass-top: rgba(43, 113, 96, 0.97); --glass-bottom: rgba(64, 139, 117, 0.98); --glass-rim: rgb(234, 255, 229);
}
.botanical-button:hover, .botanical-button:focus { background-color: rgba(0, 0, 0, 0); --glass-top: rgba(57, 141, 117, 0.98); --glass-bottom: rgba(82, 164, 136, 0.99); --glass-rim: rgb(251, 255, 238); }
.botanical-button:active { background-color: rgba(0, 0, 0, 0); --glass-top: rgba(34, 93, 79, 0.98); --glass-bottom: rgba(51, 117, 98, 0.99); }
.reference-button-label {
    position: absolute; left: 60px; right: 60px; top: 0; bottom: 0;
    color: rgb(252, 255, 244); -unity-text-align: middle-center;
    -unity-text-outline-width: 0.5px; -unity-text-outline-color: rgba(31, 88, 68, 0.8);
    text-shadow: 0 2px 2px rgba(17, 61, 47, 0.35);
}
.compact .glass-title-word { font-size: 84px; }
.compact .glass-title-time { font-size: 100px; }
.compact .botanical-button, .compact .play-button { font-size: 48px; padding: 0 60px; }
.portrait .game-title { height: 310px; padding: 20px 26px 16px 26px; }
.portrait .menu-buttons { flex-grow: 0; flex-shrink: 0; height: 520px; }
.portrait .glass-title-word { font-size: 76px; }
.portrait .glass-title-time { font-size: 92px; }
.portrait .botanical-button, .portrait .play-button { height: 125px; font-size: 43px; padding: 0 52px; max-height: 125px; }
.with-continue .botanical-button { height: 116px; min-height: 68px; }
.botanical-button:disabled { opacity: 0.42; }
.portrait.with-continue .botanical-button { height: 108px; max-height: 108px; }
.pause-mode { background-color: rgba(6, 24, 21, 0.76); }
.pause-mode .foreground-foliage, .pause-mode .falling-leaves { display: none; }
.pause-mode .menu-column { left: 50%; top: 50%; right: auto; translate: -50% -50%; width: 560px; max-width: 90%; height: 680px; max-height: 94%; }
.pause-mode .game-title { height: 180px; padding: 18px; }
.pause-mode .glass-title-word { font-size: 82px; }
.pause-mode .glass-title-time { font-size: 34px; margin-top: 0; }
.pause-mode .botanical-button { height: 115px; min-height: 65px; max-height: 115px; font-size: 44px; }
.pause-mode .menu-status { font-size: 19px; margin-top: 12px; color: rgb(225, 240, 216); }
