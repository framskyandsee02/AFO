.game-title {
    height: 36%; background-image: none;
    align-items: center; justify-content: center; padding: 22px 28px 16px 28px;
    --glass-top: rgba(92, 184, 117, 0.93); --glass-bottom: rgba(117, 184, 143, 0.94); --glass-rim: rgb(235, 255, 224);
}
.glass-title-word {
    flex-shrink: 0; margin: 0; padding: 0; max-width: 100%;
    -unity-font: url("Fonts/LobsterTwo-BoldItalic.ttf"); -unity-font-definition: initial;
    -unity-font-style: normal; font-size: 100px;
    color: rgb(251, 255, 243); -unity-text-align: middle-center;
    -unity-text-outline-width: 3px; -unity-text-outline-color: rgb(150, 219, 151);
    text-shadow: 0 3px 2px rgba(48, 106, 55, 0.30);
}
.glass-title-time { font-size: 116px; margin-top: -8px; }
.botanical-button, .play-button {
    height: 146px; font-size: 58px; padding: 0 66px;
    background-image: none; background-color: rgba(0, 0, 0, 0);
    -unity-font: url("Fonts/Quicksand-Variable.ttf"); -unity-font-definition: initial; -unity-font-style: bold;
    color: rgba(0, 0, 0, 0); -unity-text-outline-width: 0; text-shadow: 0 0 0 rgba(0, 0, 0, 0);
    --glass-top: rgba(89, 177, 116, 0.93); --glass-bottom: rgba(119, 182, 143, 0.94); --glass-rim: rgb(234, 255, 222);
}
.botanical-button:hover, .botanical-button:focus { background-color: rgba(0, 0, 0, 0); --glass-top: rgba(112, 199, 132, 0.96); --glass-bottom: rgba(141, 201, 160, 0.97); --glass-rim: rgb(251, 255, 238); }
.botanical-button:active { background-color: rgba(0, 0, 0, 0); --glass-top: rgba(81, 166, 106, 0.96); --glass-bottom: rgba(103, 173, 130, 0.96); }
.reference-button-label {
    position: absolute; left: 60px; right: 60px; top: 0; bottom: 0;
    color: rgb(252, 255, 244); -unity-text-align: middle-center;
    -unity-text-outline-width: 0.5px; -unity-text-outline-color: rgba(83, 147, 92, 0.7);
    text-shadow: 0 2px 2px rgba(51, 112, 61, 0.22);
}
.compact .glass-title-word { font-size: 84px; }
.compact .glass-title-time { font-size: 100px; }
.compact .botanical-button, .compact .play-button { font-size: 48px; padding: 0 60px; }
.portrait .game-title { height: 310px; padding: 20px 26px 16px 26px; }
.portrait .menu-buttons { flex-grow: 0; flex-shrink: 0; height: 520px; }
.portrait .glass-title-word { font-size: 76px; }
.portrait .glass-title-time { font-size: 92px; }
.portrait .botanical-button, .portrait .play-button { height: 125px; font-size: 43px; padding: 0 52px; max-height: 125px; }
